# Copy this file to .env and fill in your keys. .env is git-ignored; never commit real keys.

# OMDb: fills in posters, plot, cast, director and ratings for every title.
# Free key (1,000 requests a day): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Anthropic: powers Luna, the AI assistant. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional
# Where the shared database file lives (default: data/popcorn.db). Back this file up; it holds every member's data.
DATABASE_FILE=
# Set to 1 when running behind a reverse proxy (nginx, a host's load balancer) so real client addresses and https are detected.
TRUST_PROXY=

# Email (sign-up confirmation and password reset). Use ONE of the two:
# Option 1: Resend (https://resend.com): create an API key, and verify a sending domain (or use their test sender while developing).
RESEND_API_KEY=
# Option 2: Zoho Mail (or any SMTP provider). For Zoho: host smtp.zoho.com (smtp.zoho.eu / .in / .com.au for other regions),
# port 465, your full Zoho address as the user, and an app-specific password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Who the emails come from. Must be an address on a domain you have verified with your provider.
EMAIL_FROM=ClapBoxes <hello@your-domain.com>
# The public address of your site, used in the links inside emails (default: the address the request came to).
APP_URL=
